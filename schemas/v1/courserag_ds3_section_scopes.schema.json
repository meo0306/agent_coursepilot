{
  "$defs": {
    "DS3SectionScope": {
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Course Id",
          "type": "string"
        },
        "excluded_child_section_paths": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Child Section Paths",
          "type": "array"
        },
        "requires_boundary_review": {
          "default": false,
          "title": "Requires Boundary Review",
          "type": "boolean"
        },
        "scope_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "section_path": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Section Path",
          "type": "string"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "source_text": {
          "maxLength": 500000,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "source_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Text Sha256",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "upstream_section_record_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Section Record Id"
        },
        "upstream_section_record_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Section Record Sha256"
        }
      },
      "required": [
        "scope_id",
        "course_id",
        "section_path",
        "title",
        "source_span",
        "source_text",
        "source_text_sha256"
      ],
      "title": "DS3SectionScope",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "block_end": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block End"
        },
        "block_start": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "document_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "document_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Document Version",
          "type": "string"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "document_version",
        "document_sha256"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "schema_version": {
      "const": "courserag.ds3-section-scopes.v1",
      "default": "courserag.ds3-section-scopes.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scopes": {
      "items": {
        "$ref": "#/$defs/DS3SectionScope"
      },
      "maxItems": 24,
      "minItems": 24,
      "title": "Scopes",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scopes"
  ],
  "title": "DS3SectionScopeDataset",
  "type": "object"
}
