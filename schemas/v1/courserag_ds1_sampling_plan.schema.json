          "enum": [
            "native_pdf_page",
            "docx_structure_anchor",
            "ocr_page"
          ],
          "title": "Sample Kind",
          "type": "string"
        },
        "section_anchors": {
          "items": {
            "type": "string"
          },
          "title": "Section Anchors",
          "type": "array"
        },
        "selection_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Selection Id",
          "type": "string"
        },
        "source_page_numbers": {
          "items": {
            "type": "integer"
          },
          "title": "Source Page Numbers",
          "type": "array"
