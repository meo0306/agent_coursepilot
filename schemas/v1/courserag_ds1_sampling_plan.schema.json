          "maxLength": 160,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_page_numbers": {
          "items": {
            "type": "integer"
          },
          "title": "Document Page Numbers",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
