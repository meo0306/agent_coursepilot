    "selections": {
      "items": {
        "$ref": "#/$defs/DS1SampleSelection"
      },
      "minItems": 1,
      "title": "Selections",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "selections"
