{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Record Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "reviewed_at",
        "candidate_sha256",
        "approved_record_sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "KnowledgePointAliasAnnotation": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "basis": {
          "enum": [
            "source_text",
            "deterministic_normalization"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "basis",
        "rationale"
      ],
      "title": "KnowledgePointAliasAnnotation",
      "type": "object"
    },
    "KnowledgePointEvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Record Sha256",
          "type": "string"
        },
        "is_primary": {
          "default": false,
          "title": "Is Primary",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "definition",
            "principle",
            "method",
            "process",
            "formula",
            "example",
            "application",
            "constraint",
            "comparison",
            "support"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "role",
        "evidence_record_sha256"
      ],
      "title": "KnowledgePointEvidenceLink",
      "type": "object"
    },
    "KnowledgePointRecord": {
      "additionalProperties": false,
      "properties": {
        "alias_annotations": {
          "items": {
            "$ref": "#/$defs/KnowledgePointAliasAnnotation"
          },
          "title": "Alias Annotations",
          "type": "array"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "annotation_profile": {
          "anyOf": [
            {
              "const": "formal_ds3_v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Profile"
        },
        "annotation_rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Rationale"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_source": {
          "default": "human",
          "maxLength": 80,
          "minLength": 1,
          "title": "Candidate Source",
          "type": "string"
        },
        "canonical_name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        },
        "composite_rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Rationale"
        },
        "concept_family_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concept Family Id"
        },
        "course_id": {
          "title": "Course Id",
          "type": "string"
        },
        "cross_section_rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Section Rationale"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_links": {
          "items": {
            "$ref": "#/$defs/KnowledgePointEvidenceLink"
          },
          "title": "Evidence Links",
          "type": "array"
        },
        "gold_kp_id": {
          "title": "Gold Kp Id",
          "type": "string"
        },
        "granularity": {
          "enum": [
            "atomic",
            "composite",
            "too_broad",
            "too_narrow"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "importance": {
          "enum": [
            "core",
            "supporting",
            "optional"
          ],
          "title": "Importance",
          "type": "string"
        },
        "merge_conflict_ids": {
          "items": {
            "type": "string"
          },
          "title": "Merge Conflict Ids",
          "type": "array"
        },
        "normalized_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Name"
        },
        "parent_gold_kp_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Gold Kp Id"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "candidate"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "source_scope_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Scope Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "gold_kp_id",
        "course_id",
        "canonical_name",
        "summary",
        "evidence_ids",
        "importance",
        "granularity"
      ],
      "title": "KnowledgePointRecord",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "knowledge_points": {
      "items": {
        "$ref": "#/$defs/KnowledgePointRecord"
      },
      "title": "Knowledge Points",
      "type": "array"
    },
    "schema_version": {
      "const": "courserag.ds3.v1",
      "default": "courserag.ds3.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version"
  ],
  "title": "DS3KnowledgePointDataset",
  "type": "object"
}
