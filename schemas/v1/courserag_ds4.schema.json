{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Record Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "reviewed_at",
        "candidate_sha256",
        "approved_record_sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "QueryProcessingCase": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_scope": {
          "anyOf": [
            {
              "const": "ds4_query_processing_and_ds5_retrieval_only",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Scope"
        },
        "candidate_source": {
          "default": "human",
          "maxLength": 80,
          "minLength": 1,
          "title": "Candidate Source",
          "type": "string"
        },
        "capability": {
          "anyOf": [
            {
              "enum": [
                "query_normalization",
                "knowledge_point_linking",
                "filter_parsing",
                "query_router",
                "expansion_rewrite_constraints"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "course_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Course Id"
        },
        "expected": {
          "$ref": "#/$defs/QueryProcessingExpected"
        },
        "generation_strategy_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Strategy Sha256"
        },
        "mirrored_ds5_case_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mirrored Ds5 Case Id"
        },
        "query_family_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Family Id"
        },
        "query_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Sha256"
        },
        "raw_query": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Raw Query",
          "type": "string"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "candidate"
        },
        "source_package_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Package Id"
        },
        "upstream_approved_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Upstream Approved Sha256",
          "type": "object"
        }
      },
      "required": [
        "record_id",
        "raw_query",
        "expected"
      ],
      "title": "QueryProcessingCase",
      "type": "object"
    },
    "QueryProcessingExpected": {
      "additionalProperties": false,
      "properties": {
        "allowed_expansions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Expansions",
          "type": "array"
        },
        "filters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Filters",
          "type": "object"
        },
        "forbidden_expansions": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Expansions",
          "type": "array"
        },
        "linked_knowledge_points": {
          "items": {
            "type": "string"
          },
          "title": "Linked Knowledge Points",
          "type": "array"
        },
        "must_preserve_filters": {
          "default": true,
          "title": "Must Preserve Filters",
          "type": "boolean"
        },
        "must_preserve_terms": {
          "items": {
            "type": "string"
          },
          "title": "Must Preserve Terms",
          "type": "array"
        },
        "normalized_query": {
          "title": "Normalized Query",
          "type": "string"
        },
        "route": {
          "title": "Route",
          "type": "string"
        }
      },
      "required": [
        "normalized_query",
        "route"
      ],
      "title": "QueryProcessingExpected",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/QueryProcessingCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "schema_version": {
      "const": "courserag.ds4.v1",
      "default": "courserag.ds4.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version"
  ],
  "title": "DS4QueryProcessingDataset",
  "type": "object"
}
