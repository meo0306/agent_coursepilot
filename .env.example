# Web server
HOST=0.0.0.0
PORT=8080
MODE=
LOG_LEVEL=WARNING
GRACEFUL_SHUTDOWN_TIMEOUT=30

# Optional HTTP bearer token for FastAPI routes
AUTH_SECRET=

# Prompt-entry agent model inventory for /info and optional local tests
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
USE_FAKE_MODEL=false

# OpenAI-compatible CoursePilot generation endpoint
COMPATIBLE_BASE_URL= https://api.deepseek.com
COMPATIBLE_MODEL= deepseek-v4-flash
COMPATIBLE_API_KEY=

# P07 CourseRAG Knowledge Point extraction. Model/base URL/API key inherit
# COMPATIBLE_* when left empty; secrets never enter Artifacts or Manifests.
COURSERAG_KP_PROVIDER=openai-compatible
COURSERAG_KP_STRUCTURED_OUTPUT_METHOD=json_mode
COURSERAG_KP_MODEL=
COURSERAG_KP_BASE_URL=
COURSERAG_KP_API_KEY=
COURSERAG_KP_CONCURRENCY=4
COURSERAG_KP_MAX_RETRIES=3
COURSERAG_KP_RETRY_BASE_SECONDS=1
COURSERAG_KP_RETRY_MAX_SECONDS=30
COURSERAG_KP_TIMEOUT_SECONDS=120
COURSERAG_KP_WINDOW_MIN_TOKENS=1500
COURSERAG_KP_WINDOW_MAX_TOKENS=3000
COURSERAG_KP_PUBLISH_THRESHOLD=0.75
COURSERAG_KP_PROFILE_PATH=resources/knowledge_point_profiles/default_v1.json

# LangGraph prompt-agent persistence for /history
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=checkpoints.db

# PostgreSQL settings used when DATABASE_TYPE=postgres and as a fallback for CoursePilot DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_APPLICATION_NAME=coursepilot
POSTGRES_MIN_CONNECTIONS_PER_POOL=1
POSTGRES_MAX_CONNECTIONS_PER_POOL=1

# CoursePilot business database and storage
# If COURSEPILOT_DATABASE_URL is empty, CoursePilot reuses POSTGRES_* settings.
COURSEPILOT_DATABASE_URL=
COURSEPILOT_STORAGE_DIR=./storage
COURSEPILOT_CHROMA_DIR=./chroma_db
COURSEPILOT_MAX_REPAIR_ROUNDS=2
COURSEPILOT_DUPLICATE_THRESHOLD=0.85
COURSEPILOT_ENABLED=true

# CoursePilot generation and health checks
# generation mode: auto / llm / deterministic
COURSEPILOT_GENERATION_MODE=auto
# Set true for real evaluations so failed LLM calls fail the sample instead of
# silently using deterministic fallback.
COURSEPILOT_DISABLE_DETERMINISTIC_FALLBACK=false
COURSEPILOT_LLM_TIMEOUT_SECONDS=120
COURSEPILOT_IDEMPOTENCY_LEASE_SECONDS=14400
COURSEPILOT_ASYNC_WORKER_ENABLED=true
COURSEPILOT_ASYNC_WORKER_POLL_SECONDS=1
COURSEPILOT_ASYNC_TASK_LEASE_SECONDS=300
COURSEPILOT_ASYNC_WORKER_SHUTDOWN_TIMEOUT_SECONDS=10
COURSEPILOT_LLM_MAX_RETRIES=2
COURSEPILOT_LLM_HEALTH_CHECK_MODE=http
COURSEPILOT_LLM_HEALTH_CHECK_TIMEOUT_SECONDS=5
COURSEPILOT_TOKENIZER_PATH=deepseek_v3_tokenizer/deepseek_v3_tokenizer/tokenizer.json

# CoursePilot embeddings
# embedding provider: auto / openai-compatible / hashing
COURSEPILOT_EMBEDDING_PROVIDER=auto
COURSEPILOT_EMBEDDING_MODEL= Qwen/Qwen3-Embedding-0.6B
COURSEPILOT_EMBEDDING_BASE_URL= https://api-inference.modelscope.cn/v1/
COURSEPILOT_EMBEDDING_API_KEY=
COURSEPILOT_EMBEDDING_MAX_RETRIES=4
COURSEPILOT_EMBEDDING_RETRY_BASE_SECONDS=15
COURSEPILOT_EMBEDDING_RETRY_MAX_SECONDS=120

# P08 CourseRAG versioned retrieval. Legacy remains the safe default until an
# approved P08 Freeze Candidate exists. Put real keys only in ignored .env.
COURSERAG_RETRIEVAL_BACKEND=legacy
COURSERAG_EMBEDDING_PROVIDER=disabled
COURSERAG_EMBEDDING_MODEL=
COURSERAG_EMBEDDING_BASE_URL=
COURSERAG_EMBEDDING_API_KEY=
COURSERAG_EMBEDDING_MODEL_PATH=
COURSERAG_EMBEDDING_MODEL_BUNDLE_SHA256=
COURSERAG_EMBEDDING_WEIGHTS_SHA256=
COURSERAG_EMBEDDING_DEVICE=cuda
COURSERAG_EMBEDDING_DTYPE=bfloat16
COURSERAG_EMBEDDING_MAX_LENGTH=2048
COURSERAG_EMBEDDING_LOCAL_BATCH_SIZE=8
COURSERAG_EMBEDDING_QUERY_PROMPT_NAME=query
COURSERAG_EMBEDDING_BATCH_SIZE=64
COURSERAG_EMBEDDING_TIMEOUT_SECONDS=30
COURSERAG_EMBEDDING_EVAL_MAX_TOKENS=500000
COURSERAG_SPARSE_PROFILE_PATH=resources/retrieval_profiles/bm25_v1.json
COURSERAG_RETRIEVAL_PROFILE_PATH=resources/retrieval_profiles/default_v1.json
COURSERAG_RRF_K=60
COURSERAG_RETRIEVAL_CANDIDATE_K=30
COURSERAG_RETRIEVAL_TOP_N=8
COURSERAG_RERANKER_PROVIDER=disabled
COURSERAG_RERANKER_MODEL=
COURSERAG_RERANKER_ENDPOINT=
COURSERAG_RERANKER_API_KEY=
COURSERAG_RERANKER_MAX_DOCUMENT_TOKENS=1200
COURSERAG_RERANKER_TIMEOUT_SECONDS=30
COURSERAG_RERANKER_MAX_RETRIES=2
COURSERAG_RERANKER_EVAL_FAILURE_POLICY=fail_sample
COURSERAG_RERANKER_PRODUCTION_FAILURE_POLICY=fusion_order
COURSERAG_JINA_MAX_TOKENS=8000000
COURSERAG_COHERE_MAX_SEARCH_UNITS=500
COURSERAG_RERANKER_EVAL_CANDIDATES=jina,cohere
COURSERAG_JINA_RERANKER_BASE_URL=
COURSERAG_JINA_RERANKER_MODEL=
COURSERAG_JINA_RERANKER_API_KEY=
COURSERAG_COHERE_RERANKER_BASE_URL=
COURSERAG_COHERE_RERANKER_MODEL=
COURSERAG_COHERE_RERANKER_API_KEY=
COURSERAG_RERANKER_CANDIDATE_K=30
COURSERAG_RERANKER_TOP_N=8
COURSERAG_RERANKER_MAX_DOC_TOKENS=1200
COURSERAG_RERANKER_TRUNCATION=true
COURSERAG_RERANKER_EVAL_FALLBACK_POLICY=fail_sample
COURSERAG_RERANKER_PRODUCTION_FALLBACK_POLICY=fusion_order
COURSERAG_JINA_RERANKER_MAX_CONCURRENCY=1
COURSERAG_COHERE_RERANKER_MAX_CONCURRENCY=1
COURSERAG_COHERE_RERANKER_MAX_RPM=10

# P09 Query/Context/QA. Real keys belong only in ignored .env. QA fields may
# inherit COMPATIBLE_* when the dedicated value is empty.
COURSERAG_QUERY_PROFILE_PATH=resources/query_profiles/b7_candidate_v1.json
COURSERAG_QUERY_PROVIDER=disabled
COURSERAG_QUERY_MULTI_REWRITE=route_based
COURSERAG_QUERY_MAX_REWRITES=3
COURSERAG_QUERY_LOW_RECALL_RETRY=true
COURSERAG_QUERY_MAX_RETRIES=1
COURSERAG_CONTEXT_PROFILE_PATH=resources/context_profiles/b8_qa_v1.json
COURSERAG_CONTEXT_TOKENIZER_PATH=deepseek_v3_tokenizer/deepseek_v3_tokenizer/tokenizer.json
COURSERAG_CONTEXT_MAX_ITEMS=8
COURSERAG_CONTEXT_MAX_TOKENS=4000
COURSERAG_QA_PROVIDER=disabled
COURSERAG_QA_MODEL=
COURSERAG_QA_BASE_URL=
COURSERAG_QA_API_KEY=
COURSERAG_QA_CAPABILITY_PROFILE=deepseek_v4
COURSERAG_QA_STRUCTURED_OUTPUT_METHOD=json_mode
COURSERAG_QA_THINKING_MODE=disabled
COURSERAG_QA_TEMPERATURE=0
COURSERAG_QA_MAX_OUTPUT_TOKENS=600
COURSERAG_QA_LIST_MAX_OUTPUT_TOKENS=3200
COURSERAG_QA_TIMEOUT_SECONDS=120
COURSERAG_QA_MAX_RETRIES=2
COURSERAG_QA_MAX_REPAIR_ATTEMPTS=1
COURSERAG_QA_EVAL_MAX_TOTAL_TOKENS=2500000
COURSERAG_P09_COHERE_MAX_SEARCH_UNITS=180

# P10 incremental, verified overlay, security and Dev-only calibration.
COURSERAG_INCREMENTAL_ENABLED=true
COURSERAG_INCREMENTAL_PROFILE_PATH=resources/incremental_profiles/default_v1.json
COURSERAG_CITATION_MIGRATION_PROFILE_PATH=resources/migration_profiles/default_v1.json
COURSERAG_CITATION_AUTO_SIMILARITY=0.92
COURSERAG_CITATION_REVIEW_SIMILARITY=0.75
COURSERAG_CITATION_MIN_MARGIN=0.08
COURSERAG_VERIFIED_WRITEBACK_ENABLED=true
COURSERAG_VERIFIED_OVERLAY_ENABLED=true
COURSERAG_ENRICHMENT_RECORD_THRESHOLD=10
COURSERAG_ENRICHMENT_TOKEN_THRESHOLD=3000
COURSERAG_ENRICHMENT_MAX_AGE_SECONDS=86400
COURSERAG_ACL_ENFORCEMENT=required
COURSERAG_TRUSTED_IDENTITY_HEADERS=true
COURSERAG_MAX_DOCUMENT_BYTES=104857600
COURSERAG_MAX_PDF_PAGES=2000
COURSERAG_MAX_DOCX_ENTRIES=20000
COURSERAG_MAX_DOCX_UNCOMPRESSED_BYTES=536870912
COURSERAG_MAX_DOCX_COMPRESSION_RATIO=200
COURSERAG_MAX_OCR_DPI=600
COURSERAG_PARSE_TIMEOUT_SECONDS=300
COURSERAG_P10_DEV_MAX_DEEPSEEK_TOKENS=180000
COURSERAG_P10_DEV_MAX_COHERE_SEARCH_UNITS=0

# Streamlit frontend
AGENT_URL=http://localhost:8080
