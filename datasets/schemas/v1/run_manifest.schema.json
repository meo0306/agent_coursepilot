{
  "$defs": {
    "DatasetSplit": {
      "enum": [
        "pilot",
        "dev",
        "test"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "FallbackPolicy": {
      "enum": [
        "not_applicable",
        "fail_sample",
        "fail_run",
        "allow_recorded"
      ],
      "title": "FallbackPolicy",
      "type": "string"
    },
    "HashedArtifact": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedArtifact",
      "type": "object"
    },
    "JsonValue": {},
    "RunDatasetRef": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/DatasetSplit"
        },
        "split_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Split Sha256",
          "type": "string"
        },
        "test_lock_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Lock Sha256"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "split",
        "manifest_sha256",
        "split_sha256"
      ],
      "title": "RunDatasetRef",
      "type": "object"
    },
    "RunIntent": {
      "enum": [
        "smoke",
        "tuning",
        "evaluation",
        "replay"
      ],
      "title": "RunIntent",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "component_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Component Versions",
      "type": "object"
    },
    "configuration": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Configuration",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/RunDatasetRef"
    },
    "fallback_policy": {
      "$ref": "#/$defs/FallbackPolicy"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{7,40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "title": "Git Dirty",
      "type": "boolean"
    },
    "input_artifacts": {
      "items": {
        "$ref": "#/$defs/HashedArtifact"
      },
      "title": "Input Artifacts",
      "type": "array"
    },
    "intent": {
      "$ref": "#/$defs/RunIntent"
    },
    "llm_as_judge": {
      "default": false,
      "title": "Llm As Judge",
      "type": "boolean"
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "course-eval.run-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tuning_enabled": {
      "title": "Tuning Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "dataset",
    "intent",
    "tuning_enabled",
    "git_commit",
    "git_dirty",
    "fallback_policy",
    "random_seed"
  ],
  "title": "RunManifest",
  "type": "object"
}
