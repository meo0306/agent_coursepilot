          "type": "boolean"
        },
        "split": {
          "const": "dev",
          "default": "dev",
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "family",
        "language",
        "construction",
        "blocks",
        "expected_marked",
        "expected_axes"
      ],
      "title": "P103SecurityCase",
      "type": "object"
