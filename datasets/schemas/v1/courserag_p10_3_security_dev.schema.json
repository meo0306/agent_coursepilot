          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "construction": {
          "enum": [
            "direct",
            "indirect",
            "paraphrase",
            "cross_block",
            "long_context",
            "light_obfuscation",
            "quoted_discussion",
            "policy_description",
            "technical_documentation",
            "explicit_negation",
            "benign_imperative"
          ],
          "title": "Construction",
          "type": "string"
        },
        "expected_axes": {
          "items": {
            "type": "string"
          },
          "title": "Expected Axes",
          "type": "array"
        },
        "expected_marked": {
          "title": "Expected Marked",
          "type": "boolean"
        },
        "family": {
          "enum": [
            "policy_override",
            "role_impersonation",
            "secret_extraction",
            "tool_coercion",
            "obfuscation",
