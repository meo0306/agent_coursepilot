{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Record Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "reviewed_at",
        "candidate_sha256",
        "approved_record_sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "P18FaultCase": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_source": {
          "default": "human",
          "maxLength": 80,
          "minLength": 1,
          "title": "Candidate Source",
          "type": "string"
        },
        "category": {
          "enum": [
            "provider",
            "courserag",
            "worker",
            "persistence",
            "security"
          ],
          "title": "Category",
          "type": "string"
        },
        "course_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Course Id"
        },
        "expected_trace_assertions": {
          "items": {
            "type": "string"
          },
          "title": "Expected Trace Assertions",
          "type": "array"
        },
        "initial_state": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Initial State",
          "type": "object"
        },
        "injection_point": {
          "title": "Injection Point",
          "type": "string"
        },
        "p17_record_reused": {
          "const": false,
          "default": false,
          "title": "P17 Record Reused",
          "type": "boolean"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "candidate"
        },
        "scenario_family": {
          "title": "Scenario Family",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "contract_fixture",
            "course_grounded_security_wrapper"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "split": {
          "enum": [
            "dev",
            "blind"
          ],
          "title": "Split",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/P18FaultVariant"
          },
          "minItems": 1,
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "split",
        "category",
        "course_id",
        "scenario_family",
        "initial_state",
        "injection_point",
        "variants",
        "expected_trace_assertions",
        "source_kind"
      ],
      "title": "P18FaultCase",
      "type": "object"
    },
    "P18FaultVariant": {
      "additionalProperties": false,
      "properties": {
        "expected_error_class": {
          "title": "Expected Error Class",
          "type": "string"
        },
        "expected_side_effect_count": {
          "minimum": 0,
          "title": "Expected Side Effect Count",
          "type": "integer"
        },
        "expected_user_status": {
          "title": "Expected User Status",
          "type": "string"
        },
        "forbidden_effects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Forbidden Effects",
          "type": "array"
        },
        "injection": {
          "title": "Injection",
          "type": "string"
        },
        "resume_rule": {
          "title": "Resume Rule",
          "type": "string"
        },
        "retry_rule": {
          "title": "Retry Rule",
          "type": "string"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "injection",
        "expected_error_class",
        "expected_user_status",
        "expected_side_effect_count",
        "retry_rule",
        "resume_rule",
        "forbidden_effects"
      ],
      "title": "P18FaultVariant",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blind_commitment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Blind Commitment Sha256",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/P18FaultCase"
      },
      "maxItems": 30,
      "minItems": 30,
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "const": "coursepilot-eval",
      "default": "coursepilot-eval",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "default": "p18-formal-r1",
      "enum": [
        "p18-formal-r1",
        "p18-formal-r2"
      ],
      "title": "Dataset Version",
      "type": "string"
    },
    "schema_version": {
      "const": "coursepilot.cp-ds8-p18.v1",
      "default": "coursepilot.cp-ds8-p18.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "blind_commitment_sha256",
    "cases"
  ],
  "title": "P18FaultDataset",
  "type": "object"
}
