          "maxLength": 160,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/P09ClaimCitationSupportClaimDecision"
          },
          "title": "Claims",
          "type": "array"
        },
        "conciseness_pass": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conciseness Pass"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "reviewed": {
          "default": false,
          "title": "Reviewed",
          "type": "boolean"
        },
        "system_answer_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "System Answer Id",
          "type": "string"
        }
      },
      "required": [
