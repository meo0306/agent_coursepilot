      "default": null,
      "title": "Reviewer Id"
    },
    "schema_version": {
      "const": "courserag.p09-claim-citation-phase1-decisions.v1",
      "default": "courserag.p09-claim-citation-phase1-decisions.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Package Sha256",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "source_package_sha256",
    "cases"
  ],
  "title": "P09ClaimCitationPhase1Decisions",
  "type": "object"
