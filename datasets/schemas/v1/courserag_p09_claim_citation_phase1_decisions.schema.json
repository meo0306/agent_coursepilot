            "$ref": "#/$defs/P09ClaimCitationSupportLinkDecision"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "enum": [
                "correct_supported",
                "correct_but_uncited",
                "unsupported",
                "contradictory",
                "irrelevant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "system_claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "System Claim Id",
          "type": "string"
        }
      },
      "required": [
        "system_claim_id",
        "citations"
      ],
      "title": "P09ClaimCitationSupportClaimDecision",
      "type": "object"
    },
    "P09ClaimCitationSupportLinkDecision": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "supports_claim": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supports Claim"
        }
      },
      "required": [
        "citation_id"
      ],
      "title": "P09ClaimCitationSupportLinkDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/P09ClaimCitationSupportCaseDecision"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
