{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Record Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "reviewed_at",
        "candidate_sha256",
        "approved_record_sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "CitationMigrationCase": {
      "additionalProperties": false,
      "properties": {
        "after_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Document Sha256",
          "type": "string"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "before_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Document Sha256",
          "type": "string"
        },
        "candidate_source": {
          "default": "human",
          "maxLength": 80,
          "minLength": 1,
          "title": "Candidate Source",
          "type": "string"
        },
        "change_description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Change Description",
          "type": "string"
        },
        "expected_new_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected New Evidence Id"
        },
        "expected_status": {
          "enum": [
            "valid",
            "migrated",
            "needs_review",
            "invalid"
          ],
          "title": "Expected Status",
          "type": "string"
        },
        "old_evidence_id": {
          "title": "Old Evidence Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "candidate"
        }
      },
      "required": [
        "record_id",
        "before_document_sha256",
        "after_document_sha256",
        "old_evidence_id",
        "expected_status",
        "change_description"
      ],
      "title": "CitationMigrationCase",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CitationMigrationCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "schema_version": {
      "const": "courserag.ds6.v1",
      "default": "courserag.ds6.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version"
  ],
  "title": "DS6CitationMigrationDataset",
  "type": "object"
}
