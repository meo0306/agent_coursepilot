{
  "$defs": {
    "HashedArtifact": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_scope": {
      "const": "p11_foundation_input_contract_only",
      "default": "p11_foundation_input_contract_only",
      "title": "Approval Scope",
      "type": "string"
    },
    "approved_work_package": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "candidate_record_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Candidate Record Sha256",
      "type": "object"
    },
    "first_review_decisions": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "formal_gold_promoted": {
      "const": false,
      "default": false,
      "title": "Formal Gold Promoted",
      "type": "boolean"
    },
    "gold_status_after": {
      "const": "skeleton_no_formal_gold",
      "default": "skeleton_no_formal_gold",
      "title": "Gold Status After",
      "type": "string"
    },
    "p11_start_authorized": {
      "const": false,
      "default": false,
      "title": "P11 Start Authorized",
      "type": "boolean"
    },
    "review_id": {
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "coursepilot.p11-foundation-approval.v1",
      "default": "coursepilot.p11-foundation-approval.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "second_review_decisions": {
      "$ref": "#/$defs/HashedArtifact"
    }
  },
  "required": [
    "bundle_sha256",
    "reviewer_id",
    "reviewed_at",
    "review_id",
    "candidate",
    "approved_work_package",
    "candidate_record_sha256",
    "first_review_decisions",
    "second_review_decisions"
  ],
  "title": "P11FoundationApproval",
  "type": "object"
}
