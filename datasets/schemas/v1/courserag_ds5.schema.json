{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Record Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "reviewed_at",
        "candidate_sha256",
        "approved_record_sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "EvidenceGroup": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "required_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Evidence Ids",
          "type": "array"
        },
        "sufficiency": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Sufficiency",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "sufficiency",
        "required_evidence_ids"
      ],
      "title": "EvidenceGroup",
      "type": "object"
    },
    "GoldClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Claim Text",
          "type": "string"
        },
        "importance": {
          "default": "required",
          "enum": [
            "required",
            "optional"
          ],
          "title": "Importance",
          "type": "string"
        },
        "required_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "required_evidence_ids"
      ],
      "title": "GoldClaim",
      "type": "object"
    },
    "RetrievalQACase": {
      "additionalProperties": false,
      "properties": {
        "answerable": {
          "title": "Answerable",
          "type": "boolean"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_source": {
          "default": "human",
          "maxLength": 80,
          "minLength": 1,
          "title": "Candidate Source",
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "expected_knowledge_points": {
          "items": {
            "type": "string"
          },
          "title": "Expected Knowledge Points",
          "type": "array"
        },
        "filters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Filters",
          "type": "object"
        },
        "forbidden_claims": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Claims",
          "type": "array"
        },
        "gold_answer_type": {
          "enum": [
            "factoid",
            "list",
            "explanatory",
            "comparison",
            "procedure",
            "unanswerable"
          ],
          "title": "Gold Answer Type",
          "type": "string"
        },
        "gold_claims": {
          "items": {
            "$ref": "#/$defs/GoldClaim"
          },
          "title": "Gold Claims",
          "type": "array"
        },
        "gold_evidence_groups": {
          "items": {
            "$ref": "#/$defs/EvidenceGroup"
          },
          "title": "Gold Evidence Groups",
          "type": "array"
        },
        "gold_short_answers": {
          "items": {
            "type": "string"
          },
          "title": "Gold Short Answers",
          "type": "array"
        },
        "properties": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Properties",
          "type": "object"
        },
        "query": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "query_type": {
          "enum": [
            "exact_fact",
            "definition",
            "paraphrase",
            "comparison",
            "procedure",
            "application",
            "cross_section",
            "unanswerable"
          ],
          "title": "Query Type",
          "type": "string"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "candidate"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "query",
        "query_type",
        "answerable",
        "difficulty",
        "gold_answer_type"
      ],
      "title": "RetrievalQACase",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/RetrievalQACase"
      },
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "schema_version": {
      "const": "courserag.ds5.v1",
      "default": "courserag.ds5.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version"
  ],
  "title": "DS5RetrievalQADataset",
  "type": "object"
}
