{
  "$defs": {
    "P14ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "pass",
            "return"
          ],
          "title": "Decision",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "decision"
      ],
      "title": "P14ReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attestation_source": {
      "enum": [
        "html_export",
        "conversation_exact_bundle_approval"
      ],
      "title": "Attestation Source",
      "type": "string"
    },
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/P14ReviewDecision"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Decisions",
      "type": "array"
    },
    "expected_record_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Expected Record Ids",
      "type": "array"
    },
    "review_pass": {
      "enum": [
        "first",
        "second"
      ],
      "title": "Review Pass",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "coursepilot.p14-review-decisions.v1",
      "default": "coursepilot.p14-review-decisions.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "bundle_sha256",
    "review_pass",
    "expected_record_ids",
    "reviewer_id",
    "reviewed_at",
    "attestation_source",
    "decisions"
  ],
  "title": "P14ReviewDecisions",
  "type": "object"
}
