{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Record Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "reviewed_at",
        "candidate_sha256",
        "approved_record_sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_scope": {
      "const": "cp_ds3_and_cp_ds7_p16_pilot_input_only",
      "default": "cp_ds3_and_cp_ds7_p16_pilot_input_only",
      "title": "Approval Scope",
      "type": "string"
    },
    "approved_dataset_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Approved Dataset Hashes",
      "type": "object"
    },
    "approved_record_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Approved Record Hashes",
      "type": "object"
    },
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "candidate_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Candidate Hashes",
      "type": "object"
    },
    "external_provider_calls": {
      "const": 0,
      "default": 0,
      "title": "External Provider Calls",
      "type": "integer"
    },
    "final_coursepilot_gold_promoted": {
      "const": false,
      "default": false,
      "title": "Final Coursepilot Gold Promoted",
      "type": "boolean"
    },
    "first_review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "First Review Sha256",
      "type": "string"
    },
    "record_approvals": {
      "additionalProperties": {
        "$ref": "#/$defs/ApprovalRecord"
      },
      "title": "Record Approvals",
      "type": "object"
    },
    "record_count": {
      "const": 55,
      "default": 55,
      "title": "Record Count",
      "type": "integer"
    },
    "record_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Record Hashes",
      "type": "object"
    },
    "review_id": {
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "coursepilot.p16-bundle-approval.v1",
      "default": "coursepilot.p16-bundle-approval.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "second_review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Second Review Sha256",
      "type": "string"
    }
  },
  "required": [
    "bundle_sha256",
    "candidate_hashes",
    "record_hashes",
    "approved_dataset_hashes",
    "approved_record_hashes",
    "record_approvals",
    "first_review_sha256",
    "second_review_sha256",
    "reviewer_id",
    "reviewed_at",
    "review_id"
  ],
  "title": "P16BundleApproval",
  "type": "object"
}
