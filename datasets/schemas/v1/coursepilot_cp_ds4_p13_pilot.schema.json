{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Record Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "reviewed_at",
        "candidate_sha256",
        "approved_record_sha256"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "IssueScope": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "enum": [
            "lesson",
            "exam",
            "ppt"
          ],
          "title": "Artifact Type",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "json_path": {
          "pattern": "^\\$",
          "title": "Json Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "json_path"
      ],
      "title": "IssueScope",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "ValidationFaultCase": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact_fixture_id": {
          "title": "Artifact Fixture Id",
          "type": "string"
        },
        "artifact_type": {
          "enum": [
            "lesson",
            "exam",
            "ppt"
          ],
          "title": "Artifact Type",
          "type": "string"
        },
        "candidate_source": {
          "default": "human",
          "maxLength": 80,
          "minLength": 1,
          "title": "Candidate Source",
          "type": "string"
        },
        "clean_artifact": {
          "default": false,
          "title": "Clean Artifact",
          "type": "boolean"
        },
        "fixture_variant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Variant Id"
        },
        "gold_issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Gold Issues",
          "type": "array"
        },
        "injection_ids": {
          "items": {
            "type": "string"
          },
          "title": "Injection Ids",
          "type": "array"
        },
        "injection_paths": {
          "items": {
            "type": "string"
          },
          "title": "Injection Paths",
          "type": "array"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "candidate"
        },
        "source_provenance": {
          "items": {
            "type": "string"
          },
          "title": "Source Provenance",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "artifact_type",
        "artifact_fixture_id"
      ],
      "title": "ValidationFaultCase",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "allowed_parent_paths": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Parent Paths",
          "type": "array"
        },
        "auto_repairable": {
          "title": "Auto Repairable",
          "type": "boolean"
        },
        "code": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "issue_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Id"
        },
        "layer": {
          "default": "L1",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "title": "Layer",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "repair_strategy": {
          "default": "deterministic_patch",
          "title": "Repair Strategy",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/IssueScope"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "scope",
        "auto_repairable"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/ValidationFaultCase"
      },
      "maxItems": 30,
      "minItems": 30,
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "p13-pilot-r1",
      "default": "p13-pilot-r1",
      "title": "Dataset Version",
      "type": "string"
    },
    "schema_version": {
      "const": "coursepilot.cp-ds4-p13.v1",
      "default": "coursepilot.cp-ds4-p13.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "cases"
  ],
  "title": "CPDS4P13PilotDataset",
  "type": "object"
}
