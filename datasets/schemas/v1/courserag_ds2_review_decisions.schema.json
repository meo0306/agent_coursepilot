{
  "additionalProperties": false,
  "properties": {
    "candidate_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate File Sha256",
      "type": "string"
    },
    "completed_group_ids": {
      "items": {
        "enum": [
          "group-01",
          "group-02",
          "group-03",
          "group-04"
