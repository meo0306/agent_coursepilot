      "default": 120,
      "title": "Record Count",
      "type": "integer"
    },
    "record_notes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Record Notes",
      "type": "object"
    },
    "returned_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Returned Record Ids",
      "type": "array"
    },
    "reviewed_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reviewed Record Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "courserag.ds2-review-decisions.v1",
