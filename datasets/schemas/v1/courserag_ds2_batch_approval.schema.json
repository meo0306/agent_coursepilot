{
  "$defs": {
    "HashedArtifact": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approved File Sha256",
      "type": "string"
    },
    "approved_record_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 120,
      "minProperties": 120,
      "title": "Approved Record Sha256",
      "type": "object"
    },
    "approved_relative_path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Approved Relative Path",
      "type": "string"
    },
    "candidate_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate File Sha256",
      "type": "string"
    },
    "candidate_record_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 120,
      "minProperties": 120,
      "title": "Candidate Record Sha256",
      "type": "object"
    },
    "candidate_relative_path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Candidate Relative Path",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "notes": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Notes",
      "type": "string"
    },
    "review_decisions_artifact": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "review_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "courserag.ds2-batch-approval.v1",
      "default": "courserag.ds2-batch-approval.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "review_id",
    "reviewer_id",
    "reviewed_at",
    "candidate_relative_path",
    "candidate_file_sha256",
    "candidate_record_sha256",
    "review_decisions_artifact",
    "approved_relative_path",
    "approved_file_sha256",
    "approved_record_sha256",
    "notes"
  ],
  "title": "DS2BatchApproval",
  "type": "object"
}
