# Copy to .env.eval and fill the real model endpoints before running real eval.

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
AUTH_SECRET=

# Real OpenAI-compatible chat endpoint used by CoursePilot generation.
COMPATIBLE_BASE_URL=https://your-compatible-endpoint/v1
COMPATIBLE_MODEL=your-chat-model
COMPATIBLE_API_KEY=your-key
USE_FAKE_MODEL=false
DEFAULT_MODEL=openai-compatible

# Isolated evaluation database.
DATABASE_TYPE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# The eval runner is launched from the host and connects through the published
# Docker port. Compose overrides agent_service to use POSTGRES_HOST=postgres
# inside the Docker network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=coursepilot_eval
POSTGRES_APPLICATION_NAME=coursepilot_eval

# Isolated evaluation storage and vector store.
COURSEPILOT_STORAGE_DIR=./storage_eval
COURSEPILOT_CHROMA_DIR=./chroma_db_eval
COURSEPILOT_GENERATION_MODE=llm
COURSEPILOT_DISABLE_DETERMINISTIC_FALLBACK=true
COURSEPILOT_MAX_REPAIR_ROUNDS=2
COURSEPILOT_DUPLICATE_THRESHOLD=0.85
COURSEPILOT_LLM_TIMEOUT_SECONDS=120
COURSEPILOT_IDEMPOTENCY_LEASE_SECONDS=14400
COURSEPILOT_ASYNC_WORKER_ENABLED=true
COURSEPILOT_ASYNC_WORKER_POLL_SECONDS=1
COURSEPILOT_ASYNC_TASK_LEASE_SECONDS=300
COURSEPILOT_ASYNC_WORKER_SHUTDOWN_TIMEOUT_SECONDS=10
COURSEPILOT_LLM_MAX_RETRIES=2
COURSEPILOT_LLM_HEALTH_CHECK_MODE=http
COURSEPILOT_LLM_HEALTH_CHECK_TIMEOUT_SECONDS=5
COURSEPILOT_TOKENIZER_PATH=deepseek_v3_tokenizer/deepseek_v3_tokenizer/tokenizer.json

# Real eval uses the same LLM and embedding path as production ingestion.
COURSEPILOT_EMBEDDING_PROVIDER=openai-compatible
COURSEPILOT_EMBEDDING_MODEL=your-embedding-model
COURSEPILOT_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1/
COURSEPILOT_EMBEDDING_API_KEY=your-embedding-api-key
COURSEPILOT_EMBEDDING_MAX_RETRIES=4
COURSEPILOT_EMBEDDING_RETRY_BASE_SECONDS=15
COURSEPILOT_EMBEDDING_RETRY_MAX_SECONDS=120
COURSEPILOT_RAG_KNOWLEDGE_POINTS_MODE=llm
COURSEPILOT_EVAL_BUILD_KB_TIMEOUT_SECONDS=7200
COURSEPILOT_EVAL_GENERATION_TIMEOUT_SECONDS=1800

AGENT_URL=http://localhost:8080
